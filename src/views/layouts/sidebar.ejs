<!-- Mobile Backdrop Overlay -->
<div id="sidebarBackdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-40 hidden md:hidden transition-opacity"></div>

<!-- Responsive Sidebar Drawer -->
<aside id="appSidebar" class="no-print fixed inset-y-0 left-0 z-50 w-72 bg-slate-900 text-slate-300 flex-shrink-0 flex flex-col justify-between min-h-screen border-r border-slate-800 transform -translate-x-full transition-transform duration-300 ease-in-out md:static md:translate-x-0 md:w-64 shadow-2xl md:shadow-none">
  <div>
    <!-- Logo & Brand Header -->
    <div class="h-16 flex items-center justify-between px-6 border-b border-slate-800/80 bg-slate-950/40">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white shadow-lg shadow-emerald-900/30">
          <i data-lucide="cross" class="w-6 h-6 stroke-[2.5]"></i>
        </div>
        <div>
          <h1 class="text-base font-bold text-white tracking-wide leading-tight">E-UKS</h1>
          <p class="text-[11px] text-slate-400 font-medium">Rekam Medis Sekolah</p>
        </div>
      </div>

      <!-- Close Button (Mobile Only) -->
      <button id="closeSidebarBtn" type="button" aria-label="Tutup Menu"
        class="md:hidden p-1.5 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- Role Badge -->
    <div class="px-6 py-4 border-b border-slate-800/50 bg-slate-900/50">
      <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider mb-1">Peran Aktif</div>
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-lg text-xs font-semibold 
        <% if (user.role === 'ADMIN_UKS') { %> bg-purple-500/10 text-purple-400 border border-purple-500/20 <% } else if (user.role === 'PETUGAS_UKS') { %> bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 <% } else { %> bg-blue-500/10 text-blue-400 border border-blue-500/20 <% } %>">
        <span class="w-2 h-2 rounded-full <% if (user.role === 'ADMIN_UKS') { %> bg-purple-400 <% } else if (user.role === 'PETUGAS_UKS') { %> bg-emerald-400 <% } else { %> bg-blue-400 <% } %>"></span>
        <%= user.role === 'ADMIN_UKS' ? 'Admin UKS' : (user.role === 'PETUGAS_UKS' ? 'Petugas UKS / PMR' : 'Siswa Pasien') %>
      </div>
    </div>

    <!-- Navigation Menu Links -->
    <nav class="p-4 space-y-1 overflow-y-auto max-h-[calc(100vh-180px)]">
      <% if (user.role === 'ADMIN_UKS') { %>
        <div class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Manajemen Admin</div>
        <a href="/admin/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="layout-dashboard" class="w-4 h-4 text-slate-400"></i>
          Dashboard Analitik
        </a>
        <a href="/admin/medicines" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="pill" class="w-4 h-4 text-slate-400"></i>
          Master Obat & P3K
        </a>
        <a href="/admin/stock-alerts" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="alert-triangle" class="w-4 h-4 text-slate-400"></i>
          Monitoring Stok & Expired
        </a>
        <a href="/admin/petugas" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="user-check" class="w-4 h-4 text-slate-400"></i>
          Akun Petugas UKS
        </a>
        <a href="/admin/siswa" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="graduation-cap" class="w-4 h-4 text-slate-400"></i>
          Akun Siswa
        </a>
      <% } else if (user.role === 'PETUGAS_UKS') { %>
        <div class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Layanan Medis</div>
        <a href="/petugas/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="activity" class="w-4 h-4 text-slate-400"></i>
          Dashboard Petugas
        </a>
        <a href="/petugas/visits" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="clipboard-list" class="w-4 h-4 text-slate-400"></i>
          Daftar Kunjungan UKS
        </a>
        <a href="/petugas/visits/create" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="user-plus" class="w-4 h-4 text-slate-400"></i>
          Registrasi Kunjungan
        </a>
        <a href="/petugas/siswa" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="users" class="w-4 h-4 text-slate-400"></i>
          Data & Tambah Siswa
        </a>
        <a href="/petugas/reports" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="file-spreadsheet" class="w-4 h-4 text-slate-400"></i>
          Rekap Laporan Bulanan
        </a>
      <% } else if (user.role === 'SISWA') { %>
        <div class="px-3 py-2 text-[11px] font-bold text-slate-500 uppercase tracking-wider">Layanan Siswa</div>
        <a href="/siswa/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="home" class="w-4 h-4 text-slate-400"></i>
          Dashboard Saya
        </a>
        <a href="/siswa/medical-records" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="stethoscope" class="w-4 h-4 text-slate-400"></i>
          Rekam Medis Saya
        </a>
        <a href="/siswa/health-profile" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="heart-pulse" class="w-4 h-4 text-slate-400"></i>
          Riwayat Alergi & Penyakit
        </a>
        <a href="/siswa/permits" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition hover:bg-slate-800 hover:text-white text-slate-300">
          <i data-lucide="file-text" class="w-4 h-4 text-slate-400"></i>
          Status Izin Istirahat Digital
        </a>
      <% } %>
    </nav>
  </div>

  <!-- User Info & Logout Footer -->
  <div class="p-4 border-t border-slate-800/80 bg-slate-950/30">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3 overflow-hidden">
        <div class="w-9 h-9 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center font-bold text-emerald-400 text-sm flex-shrink-0">
          <%= (user && user.nama) ? user.nama.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div class="truncate">
          <p class="text-xs font-semibold text-white truncate"><%= (user && user.nama) ? user.nama : (user ? user.username : 'Pengguna') %></p>
          <p class="text-[11px] text-slate-400 truncate">@<%= user ? user.username : '' %></p>
        </div>
      </div>
      <a href="/logout" title="Keluar" class="p-2 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-lg transition">
        <i data-lucide="log-out" class="w-4 h-4"></i>
      </a>
    </div>
  </div>
</aside>
