<header class="no-print bg-white border-b border-slate-200/80 px-4 sm:px-6 py-3 sm:py-3.5 flex items-center justify-between shadow-sm sticky top-0 z-30">
  <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
    <!-- Mobile Hamburger Menu Button -->
    <button id="openSidebarBtn" type="button" aria-label="Buka Navigasi"
      class="md:hidden p-2 -ml-1 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition flex-shrink-0">
      <i data-lucide="menu" class="w-5 h-5"></i>
    </button>

    <div class="truncate">
      <h2 class="text-sm sm:text-base md:text-lg font-bold text-slate-800 tracking-tight truncate"><%= (typeof title !== 'undefined' && title) ? title : 'E-UKS' %></h2>
    </div>
  </div>

  <div class="flex items-center gap-2 sm:gap-4 flex-shrink-0">
    <!-- Current Date Indicator -->
    <div class="hidden lg:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 text-xs font-medium border border-slate-200/60">
      <i data-lucide="calendar" class="w-3.5 h-3.5 text-slate-500"></i>
      <span><%= new Date().toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
    </div>

    <!-- Quick Logout -->
    <a href="/logout" class="flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1.5 rounded-xl text-xs font-semibold bg-rose-50 text-rose-600 hover:bg-rose-100 border border-rose-200/60 transition">
      <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
      <span class="hidden sm:inline">Logout</span>
    </a>
  </div>
</header>
