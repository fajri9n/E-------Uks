<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4">
  <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-slate-100 p-8 text-center">
    <div class="w-20 h-20 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center mx-auto mb-6">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>
    <h1 class="text-3xl font-bold text-slate-800 mb-2">403 Forbidden</h1>
    <p class="text-slate-600 text-sm mb-6"><%= message || 'Anda tidak memiliki hak akses untuk membuka halaman ini.' %></p>
    <div class="flex justify-center gap-3">
      <a href="javascript:history.back()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium rounded-xl transition">
        Kembali
      </a>
      <% if (user) { %>
        <% if (user.role === 'ADMIN_UKS') { %>
          <a href="/admin/dashboard" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl transition">
            Ke Dashboard Admin
          </a>
        <% } else if (user.role === 'PETUGAS_UKS') { %>
          <a href="/petugas/dashboard" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl transition">
            Ke Dashboard Petugas
          </a>
        <% } else { %>
          <a href="/siswa/dashboard" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl transition">
            Ke Dashboard Siswa
          </a>
        <% } %>
      <% } else { %>
        <a href="/login" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl transition">
          Halaman Login
        </a>
      <% } %>
    </div>
  </div>
</body>
</html>
