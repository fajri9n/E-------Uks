<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; padding: 0 !important; }
    }
  </style>
</head>
<body class="bg-slate-100 min-h-screen p-4 sm:p-8 flex flex-col items-center">

  <!-- Print Action Controls -->
  <div class="no-print max-w-5xl w-full mb-4 flex justify-between items-center">
    <button onclick="window.history.back()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-semibold rounded-xl transition">
      &larr; Kembali
    </button>
    <button onclick="window.print()" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow transition flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
      <span>Cetak Laporan Bulanan (Print / PDF)</span>
    </button>
  </div>

  <!-- Printable Container -->
  <div class="max-w-5xl w-full bg-white border border-slate-300 shadow-xl p-8 rounded-2xl print:shadow-none print:border-none">
    
    <!-- Header Kop -->
    <div class="border-b-2 border-slate-800 pb-3 mb-6 text-center">
      <h2 class="text-xs font-bold uppercase tracking-widest text-slate-500">PEMERINTAH KOTA / KABUPATEN - DINAS PENDIDIKAN</h2>
      <h1 class="text-xl font-extrabold uppercase text-slate-900 tracking-wide mt-1">SMK / SMA NEGERI UNGGULAN SEKOLAH</h1>
      <h3 class="text-sm font-bold text-emerald-700 uppercase tracking-wider mt-0.5">LAPORAN REKAPITULASI PELAYANAN USAHA KESEHATAN SEKOLAH (UKS)</h3>
      <p class="text-xs font-semibold text-slate-700 mt-1">Periode Bulan: <%= monthName %> <%= year %></p>
    </div>

    <!-- Table Rekapitulasi -->
    <table class="w-full text-left border-collapse border border-slate-300 text-xs mb-6">
      <thead>
        <tr class="bg-slate-100 text-slate-800 font-bold border-b border-slate-300 uppercase text-[10px]">
          <th class="p-2 border border-slate-300 text-center w-8">No</th>
          <th class="p-2 border border-slate-300 w-24">Tanggal</th>
          <th class="p-2 border border-slate-300">Nama Siswa & NISN</th>
          <th class="p-2 border border-slate-300">Keluhan & Vital</th>
          <th class="p-2 border border-slate-300">Tindakan Medis & Obat</th>
          <th class="p-2 border border-slate-300 text-center w-28">Status Akhir</th>
          <th class="p-2 border border-slate-300 w-32">Petugas Jaga</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <% if (visits.length === 0) { %>
          <tr>
            <td colspan="7" class="p-6 text-center text-slate-400 italic">Tidak ada transaksi rekam medis UKS pada periode bulan ini.</td>
          </tr>
        <% } else { %>
          <% visits.forEach((v, index) => { %>
            <tr>
              <td class="p-2 border border-slate-300 text-center font-bold text-slate-500"><%= index + 1 %></td>
              <td class="p-2 border border-slate-300 whitespace-nowrap">
                <%= new Date(v.tglKunjungan).toLocaleDateString('id-ID') %><br>
                <span class="text-[10px] text-slate-500"><%= v.jamMasuk %> WIB</span>
              </td>
              <td class="p-2 border border-slate-300 font-bold">
                <%= v.student.nama %><br>
                <span class="text-[10px] font-normal text-slate-500">NISN: <%= v.student.nisn || '-' %></span>
              </td>
              <td class="p-2 border border-slate-300">
                <p class="font-medium"><%= v.keluhan %></p>
                <% if (v.suhuTubuh || v.tensi) { %>
                  <p class="text-[10px] text-slate-500">Suhu: <%= v.suhuTubuh || '-' %>°C | Tensi: <%= v.tensi || '-' %></p>
                <% } %>
              </td>
              <td class="p-2 border border-slate-300">
                <p><%= v.tindakan || '-' %></p>
                <% if (v.prescriptions && v.prescriptions.length > 0) { %>
                  <p class="text-[10px] text-emerald-800 font-semibold mt-0.5">
                    Obat: <%= v.prescriptions.map(p => p.medicine.namaObat + ' (' + p.jumlah + ')').join(', ') %>
                  </p>
                <% } %>
              </td>
              <td class="p-2 border border-slate-300 text-center font-bold">
                <%= v.status %>
              </td>
              <td class="p-2 border border-slate-300">
                <%= v.petugas.nama %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>

    <!-- Tanda Tangan Lap -->
    <div class="grid grid-cols-2 text-center text-xs mt-10">
      <div>
        <p class="text-slate-500">Mengetahui,</p>
        <p class="font-bold text-slate-900">Kepala Sekolah / Pembina UKS</p>
        <div class="h-16"></div>
        <p class="font-bold text-slate-900 underline">Drs. H. Ahmad Pembina, M.Pd</p>
        <p class="text-[10px] text-slate-500">NIP. 19780115 200501 1 002</p>
      </div>

      <div>
        <p class="text-slate-500">Kota Sekolah, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        <p class="font-bold text-slate-900">Petugas / Pengelola Rekam Medis UKS</p>
        <div class="h-16"></div>
        <p class="font-bold text-slate-900 underline"><%= user ? user.nama : 'Siti Nurhaliza, A.Md.Kep' %></p>
        <p class="text-[10px] text-slate-500">Tenaga Medis / Tim PMR</p>
      </div>
    </div>

  </div>
</body>
</html>
