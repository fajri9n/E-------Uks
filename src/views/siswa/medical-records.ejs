<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../layouts/topbar') %>

  <main class="p-6 space-y-6">
    <div>
      <h2 class="text-xl font-bold text-slate-800">Riwayat Rekam Medis Pribadi</h2>
      <p class="text-xs text-slate-500">Seluruh histori pemeriksaan, diagnosa keluhan, dan obat yang pernah diberikan oleh petugas UKS</p>
    </div>

    <!-- Timeline Records -->
    <div class="space-y-4">
      <% if (records.length === 0) { %>
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 text-center text-slate-400">
          Belum ada rekam medis kunjungan tersimpan untuk akun Anda.
        </div>
      <% } else { %>
        <% records.forEach(r => { %>
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-3 gap-2">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">
                  <i data-lucide="stethoscope" class="w-5 h-5"></i>
                </div>
                <div>
                  <h3 class="text-sm font-bold text-slate-800"><%= new Date(r.tglKunjungan).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></h3>
                  <p class="text-[11px] text-slate-500">Jam Masuk: <%= r.jamMasuk %> WIB <% if (r.jamKeluar) { %> | Jam Keluar: <%= r.jamKeluar %> WIB <% } %></p>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <% if (r.status === 'DIRAWAT') { %>
                  <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full font-bold text-xs">STATUS: DIRAWAT UKS</span>
                <% } else if (r.status === 'KEMBALI_KELAS') { %>
                  <span class="px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full font-bold text-xs">STATUS: KEMBALI KELAS</span>
                <% } else if (r.status === 'PULANG') { %>
                  <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full font-bold text-xs">STATUS: IZIN PULANG</span>
                <% } else { %>
                  <span class="px-3 py-1 bg-rose-100 text-rose-800 rounded-full font-bold text-xs">STATUS: DIRUJUK FASKES</span>
                <% } %>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
              <div class="space-y-1 bg-slate-50 p-3 rounded-xl">
                <span class="font-bold text-slate-700 block">Keluhan Utama & Vital Signs:</span>
                <p class="text-slate-800 font-medium"><%= r.keluhan %></p>
                <p class="text-[11px] text-slate-500 pt-1">
                  Suhu Tubuh: <strong><%= r.suhuTubuh || '-' %>°C</strong> | Tensi Darah: <strong><%= r.tensi || '-' %></strong>
                </p>
              </div>

              <div class="space-y-1 bg-slate-50 p-3 rounded-xl">
                <span class="font-bold text-slate-700 block">Tindakan Pertolongan Pertama:</span>
                <p class="text-slate-800"><%= r.tindakan || 'Tidak ada tindakan khusus' %></p>
                <p class="text-[11px] text-slate-500 pt-1">Petugas Jaga: <strong><%= r.petugas.nama %></strong></p>
              </div>
            </div>

            <% if (r.prescriptions && r.prescriptions.length > 0) { %>
              <div class="pt-2 border-t border-slate-100">
                <span class="text-xs font-bold text-slate-700 uppercase tracking-wider block mb-1.5">Resep Obat yang Diberikan:</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <% r.prescriptions.forEach(p => { %>
                    <div class="p-2.5 bg-emerald-50 border border-emerald-200/60 rounded-xl text-xs flex justify-between items-center">
                      <div>
                        <span class="font-bold text-emerald-900"><%= p.medicine.namaObat %></span>
                        <span class="text-[11px] text-emerald-700 block"><%= p.dosis %></span>
                      </div>
                      <span class="px-2 py-0.5 bg-emerald-600 text-white font-bold rounded text-[10px]">
                        <%= p.jumlah %> <%= p.medicine.satuan %>
                      </span>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } %>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
