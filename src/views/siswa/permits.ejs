<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../layouts/topbar') %>

  <main class="p-4 sm:p-6 space-y-6">
    <div>
      <h2 class="text-xl font-bold text-slate-800">Status Izin Istirahat UKS Digital</h2>
      <p class="text-xs text-slate-500">Pantau keabsahan surat izin istirahat di UKS / rujukan pulang yang telah diterbitkan oleh petugas medis</p>
    </div>

    <div class="space-y-4">
      <% if (permits.length === 0) { %>
        <div class="bg-white p-8 rounded-2xl border border-slate-200/80 text-center text-slate-400">
          Belum ada surat izin istirahat / rujukan pulang digital yang pernah diterbitkan.
        </div>
      <% } else { %>
        <% permits.forEach(p => { %>
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-slate-100 pb-3 gap-2">
              <div>
                <span class="text-[10px] font-mono font-bold uppercase text-emerald-600">ID Digital: UKS-PERMIT-<%= p.id %></span>
                <h3 class="text-base font-bold text-slate-800">
                  Surat <%= p.status === 'PULANG' ? 'Izin Pulang ke Rumah' : (p.status === 'DIRUJUK' ? 'Rujukan Puskesmas' : 'Izin Istirahat Ruang UKS') %>
                </h3>
                <p class="text-xs text-slate-500">Diterbitkan pada <%= new Date(p.tglKunjungan).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %> oleh <%= p.petugas.nama %></p>
              </div>

              <div class="flex items-center gap-3">
                <% if (p.status === 'PULANG') { %>
                  <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full font-bold text-xs">DISETUJUI PULANG</span>
                <% } else if (p.status === 'DIRUJUK') { %>
                  <span class="px-3 py-1 bg-rose-100 text-rose-800 rounded-full font-bold text-xs">DIRUJUK PUSKESMAS</span>
                <% } else { %>
                  <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full font-bold text-xs">DIRAWAT DI BED UKS</span>
                <% } %>

                <a href="/permit/<%= p.id %>/print" target="_blank"
                  class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-xl border border-emerald-200 transition flex items-center gap-1">
                  <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                  <span>Lihat Surat</span>
                </a>
              </div>
            </div>

            <div class="p-3.5 bg-slate-50 border border-slate-200/80 rounded-xl text-xs space-y-1">
              <span class="font-bold text-slate-700 block">Catatan & Instruksi Istirahat:</span>
              <p class="text-slate-800"><%= p.catatanSurat || 'Siswa dalam perawatan dan pengawasan ruang UKS.' %></p>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
