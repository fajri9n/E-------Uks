<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../layouts/topbar') %>

  <main class="p-6 space-y-6">
    <!-- Welcome Header Card -->
    <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-teal-600 text-white p-6 rounded-3xl shadow-lg">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="px-2.5 py-1 bg-white/20 backdrop-blur-md rounded-lg text-[11px] font-bold uppercase tracking-wider text-blue-100">Portal Layanan Kesehatan Siswa</span>
          <h2 class="text-2xl font-extrabold tracking-tight mt-2">Selamat Datang, <%= user.nama %>!</h2>
          <p class="text-blue-100 text-xs mt-1">NISN: <%= user.nisn || '-' %> | Golongan Darah: <strong class="text-white"><%= user.golonganDarah || '-' %></strong></p>
        </div>

        <a href="/siswa/health-profile" class="px-4 py-2.5 bg-white hover:bg-blue-50 text-blue-700 font-bold text-xs rounded-xl shadow transition self-start sm:self-auto">
          Update Alergi & Riwayat Kesehatan
        </a>
      </div>
    </div>

    <!-- Health Profile Overview & Emergency Banner -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
          <i data-lucide="heart-pulse" class="w-4 h-4 text-rose-500"></i>
          Profil Kesehatan & Peringatan Alergi Obat Anda
        </h3>
        <a href="/siswa/health-profile" class="text-xs font-semibold text-emerald-600 hover:text-emerald-700">Edit Profil &rarr;</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-3.5 bg-slate-50 border border-slate-200/80 rounded-xl">
          <span class="text-[10px] font-bold text-slate-400 uppercase">Riwayat Penyakit Bawaan</span>
          <p class="font-bold text-slate-800 mt-1"><%= healthProfile ? (healthProfile.riwayatPenyakit || 'Tidak Ada') : 'Belum diisi' %></p>
        </div>

        <div class="p-3.5 bg-rose-50 border border-rose-200/80 rounded-xl">
          <span class="text-[10px] font-bold text-rose-600 uppercase">⚠ Alergi Obat-Obatan</span>
          <p class="font-bold text-rose-800 mt-1"><%= healthProfile ? (healthProfile.alergiObat || 'Tidak Ada') : 'Belum diisi' %></p>
        </div>

        <div class="p-3.5 bg-amber-50 border border-amber-200/80 rounded-xl">
          <span class="text-[10px] font-bold text-amber-700 uppercase">Alergi Makanan</span>
          <p class="font-bold text-amber-900 mt-1"><%= healthProfile ? (healthProfile.alergiMakanan || 'Tidak Ada') : 'Belum diisi' %></p>
        </div>
      </div>
    </div>

    <!-- Recent Medical Records -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
      <div class="flex justify-between items-center mb-4">
        <div>
          <h3 class="text-base font-bold text-slate-800">Riwayat Berobat & Kunjungan Ruang UKS Saya</h3>
          <p class="text-xs text-slate-500">Catatan riwayat rekam medis pribadi</p>
        </div>
        <a href="/siswa/medical-records" class="text-xs font-semibold text-emerald-600 hover:text-emerald-700">Lihat Selengkapnya &rarr;</a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
              <th class="py-3 px-3">Tanggal Kunjungan</th>
              <th class="py-3 px-3">Keluhan & Vital</th>
              <th class="py-3 px-3">Tindakan Medis</th>
              <th class="py-3 px-3">Resep Obat</th>
              <th class="py-3 px-3 text-center">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs">
            <% if (recentRecords.length === 0) { %>
              <tr>
                <td colspan="5" class="py-8 text-center text-slate-400">Anda belum pernah melakukan kunjungan / berobat di ruang UKS.</td>
              </tr>
            <% } else { %>
              <% recentRecords.forEach(r => { %>
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="py-3.5 px-3 font-medium text-slate-700 whitespace-nowrap">
                    <%= new Date(r.tglKunjungan).toLocaleDateString('id-ID') %>
                    <span class="text-slate-400 text-[11px] block"><%= r.jamMasuk %> WIB</span>
                  </td>
                  <td class="py-3.5 px-3">
                    <p class="font-semibold text-slate-800"><%= r.keluhan %></p>
                    <% if (r.suhuTubuh || r.tensi) { %>
                      <span class="text-[10px] text-slate-500">Suhu: <%= r.suhuTubuh || '-' %>°C | Tensi: <%= r.tensi || '-' %></span>
                    <% } %>
                  </td>
                  <td class="py-3.5 px-3 text-slate-600"><%= r.tindakan || '-' %></td>
                  <td class="py-3.5 px-3 text-slate-600">
                    <% if (r.prescriptions && r.prescriptions.length > 0) { %>
                      <% r.prescriptions.forEach(p => { %>
                        <span class="inline-block px-2 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200/60 rounded text-[10px] font-medium mr-1 mb-1">
                          <%= p.medicine.namaObat %> (<%= p.jumlah %> <%= p.medicine.satuan %>)
                        </span>
                      <% }); %>
                    <% } else { %>
                      -
                    <% } %>
                  </td>
                  <td class="py-3.5 px-3 text-center whitespace-nowrap">
                    <% if (r.status === 'DIRAWAT') { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800">DIRAWAT</span>
                    <% } else if (r.status === 'KEMBALI_KELAS') { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">KEMBALI KELAS</span>
                    <% } else if (r.status === 'PULANG') { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-purple-100 text-purple-800">IZIN PULANG</span>
                    <% } else { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-100 text-rose-800">DIRUJUK</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
