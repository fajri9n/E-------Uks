<%- include('../../layouts/header') %>
<%- include('../../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../../layouts/topbar') %>

  <main class="p-4 sm:p-6 max-w-3xl mx-auto w-full space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-slate-800">Edit Akun Siswa</h2>
        <p class="text-xs text-slate-500">Perbarui informasi identitas, akses akun, dan profil kesehatan siswa</p>
      </div>
      <a href="/admin/siswa" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs rounded-xl transition">
        &larr; Kembali
      </a>
    </div>

    <% if (error) { %>
      <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 text-rose-800 text-sm">
        <i data-lucide="alert-triangle" class="w-5 h-5 flex-shrink-0 text-rose-600"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
      <form action="/admin/siswa/<%= siswa.id %>/edit" method="POST" class="space-y-6">
        <!-- Identitas Pokok Siswa -->
        <div>
          <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2">
            <i data-lucide="user" class="w-4 h-4 text-emerald-600"></i>
            Identitas Pokok Siswa
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Nama Lengkap Siswa</label>
              <input type="text" name="nama" value="<%= siswa.nama %>" required
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">NISN</label>
              <input type="text" name="nisn" value="<%= siswa.nisn || '' %>" placeholder="Nomor Induk Siswa Nasional"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Golongan Darah</label>
              <select name="golonganDarah" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
                <option value="">-- Pilih Golongan Darah --</option>
                <option value="A" <%= siswa.golonganDarah === 'A' ? 'selected' : '' %>>A</option>
                <option value="B" <%= siswa.golonganDarah === 'B' ? 'selected' : '' %>>B</option>
                <option value="AB" <%= siswa.golonganDarah === 'AB' ? 'selected' : '' %>>AB</option>
                <option value="O" <%= siswa.golonganDarah === 'O' ? 'selected' : '' %>>O</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">No. HP / WhatsApp Ortu</label>
              <input type="text" name="teleponOrtu" value="<%= siswa.teleponOrtu || '' %>" placeholder="081234567890"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>
          </div>
        </div>

        <!-- Akun Login Siswa -->
        <div class="border-t border-slate-100 pt-5">
          <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2">
            <i data-lucide="key" class="w-4 h-4 text-emerald-600"></i>
            Akses Login Siswa
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Username Login</label>
              <input type="text" name="username" value="<%= siswa.username %>" required
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
                Password Baru <span class="text-slate-400 font-normal normal-case">(Biarkan kosong jika tidak ganti)</span>
              </label>
              <input type="password" name="password" placeholder="Masukkan password baru jika ingin diubah"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>
          </div>
        </div>

        <!-- Profil Riwayat Kesehatan Siswa -->
        <div class="border-t border-slate-100 pt-5">
          <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2">
            <i data-lucide="heart-pulse" class="w-4 h-4 text-emerald-600"></i>
            Profil Kesehatan & Catatan Medis
          </h3>

          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
                Alergi Obat <span class="text-rose-600 font-bold">(Penting untuk Petugas UKS)</span>
              </label>
              <input type="text" name="alergiObat" value="<%= (siswa.healthProfile && siswa.healthProfile.alergiObat) || '' %>" placeholder="Penisilin, dsb atau 'Tidak Ada'"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Riwayat Penyakit</label>
                <input type="text" name="riwayatPenyakit" value="<%= (siswa.healthProfile && siswa.healthProfile.riwayatPenyakit) || '' %>" placeholder="Asma, vertigo, maag, dsb"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Alergi Makanan / Lainnya</label>
                <input type="text" name="alergiMakanan" value="<%= (siswa.healthProfile && siswa.healthProfile.alergiMakanan) || '' %>" placeholder="Kacang, udang, debu, dsb"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Kontak Darurat</label>
              <input type="text" name="kontakDarurat" value="<%= (siswa.healthProfile && siswa.healthProfile.kontakDarurat) || '' %>" placeholder="Nama wali & nomor telepon"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>
          </div>
        </div>

        <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100">
          <a href="/admin/siswa" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 font-semibold text-xs rounded-xl transition">
            Batal
          </a>
          <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-md shadow-emerald-600/20 transition">
            Perbarui Data Siswa
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../../layouts/footer') %>
