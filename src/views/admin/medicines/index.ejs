<%- include('../../layouts/header') %>
<%- include('../../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../../layouts/topbar') %>

  <main class="p-4 sm:p-6 space-y-4 sm:space-y-6">
    <!-- Header & Action Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-slate-800">Master Data Obat-Obatan & Alat P3K</h2>
        <p class="text-xs text-slate-500">Kelola daftar inventaris obat, dosis, aturan pakai, dan masa simpan P3K</p>
      </div>

      <a href="/admin/medicines/create"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-semibold text-xs rounded-xl shadow-md shadow-emerald-600/20 transition">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Tambah Obat / Alat Baru</span>
      </a>
    </div>

    <!-- Alert Notices -->
    <% if (success) { %>
      <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3 text-emerald-800 text-sm">
        <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 text-emerald-600"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 text-rose-800 text-sm">
        <i data-lucide="alert-triangle" class="w-5 h-5 flex-shrink-0 text-rose-600"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Filter & Search Bar -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm">
      <form action="/admin/medicines" method="GET" class="flex flex-col sm:flex-row gap-3">
        <div class="flex-1 relative">
          <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" name="search" value="<%= search %>" placeholder="Cari nama obat..."
            class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
        </div>

        <select name="kategori" onchange="this.form.submit()"
          class="px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
          <option value="">Semua Kategori</option>
          <option value="TABLET" <%= kategori === 'TABLET' ? 'selected' : '' %>>TABLET</option>
          <option value="SIRUP" <%= kategori === 'SIRUP' ? 'selected' : '' %>>SIRUP</option>
          <option value="SALEP" <%= kategori === 'SALEP' ? 'selected' : '' %>>SALEP</option>
          <option value="ALAT" <%= kategori === 'ALAT' ? 'selected' : '' %>>ALAT P3K</option>
        </select>

        <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-xl transition">
          Filter
        </button>
      </form>
    </div>

    <!-- Table Master Obat -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[700px] text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200/80 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
              <th class="py-3.5 px-4">Nama Obat / Alat</th>
              <th class="py-3.5 px-4">Kategori</th>
              <th class="py-3.5 px-4 text-center">Stok</th>
              <th class="py-3.5 px-4">Satuan</th>
              <th class="py-3.5 px-4">Tgl Kadaluarsa</th>
              <th class="py-3.5 px-4">Aturan Pakai</th>
              <th class="py-3.5 px-4 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs">
            <% if (medicines.length === 0) { %>
              <tr>
                <td colspan="7" class="py-8 text-center text-slate-400">Tidak ada data obat / alat P3K yang cocok.</td>
              </tr>
            <% } else { %>
              <% const now = new Date(); %>
              <% medicines.forEach(med => { %>
                <% const isExpired = new Date(med.tglKadaluarsa) <= now; %>
                <% const isLowStock = med.stok <= 10; %>
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="py-3.5 px-4 font-bold text-slate-800">
                    <%= med.namaObat %>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="px-2.5 py-1 rounded-lg text-[11px] font-semibold 
                      <% if (med.kategori === 'TABLET') { %> bg-blue-50 text-blue-700 border border-blue-200/60 <% } else if (med.kategori === 'SIRUP') { %> bg-purple-50 text-purple-700 border border-purple-200/60 <% } else if (med.kategori === 'SALEP') { %> bg-amber-50 text-amber-700 border border-amber-200/60 <% } else { %> bg-teal-50 text-teal-700 border border-teal-200/60 <% } %>">
                      <%= med.kategori %>
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-center font-bold text-sm <%= isLowStock ? 'text-rose-600' : 'text-slate-800' %>">
                    <%= med.stok %>
                    <% if (isLowStock) { %>
                      <span class="block text-[10px] text-rose-500 font-normal">Stok Menipis</span>
                    <% } %>
                  </td>
                  <td class="py-3.5 px-4 text-slate-600"><%= med.satuan %></td>
                  <td class="py-3.5 px-4 font-medium <%= isExpired ? 'text-rose-600 font-bold' : 'text-slate-700' %>">
                    <%= new Date(med.tglKadaluarsa).toLocaleDateString('id-ID') %>
                    <% if (isExpired) { %>
                      <span class="inline-block px-1.5 py-0.5 ml-1 bg-rose-100 text-rose-700 text-[10px] font-bold rounded">EXPIRED</span>
                    <% } %>
                  </td>
                  <td class="py-3.5 px-4 text-slate-600 max-w-xs truncate"><%= med.aturanPakai %></td>
                  <td class="py-3.5 px-4 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center gap-2">
                      <a href="/admin/medicines/<%= med.id %>/edit" title="Edit Obat"
                        class="p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition">
                        <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                      </a>

                      <form action="/admin/medicines/<%= med.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus obat ini?');">
                        <button type="submit" title="Hapus Obat"
                          class="p-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg transition">
                          <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../../layouts/footer') %>
