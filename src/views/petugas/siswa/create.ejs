<%- include('../../layouts/header') %>
<%- include('../../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../../layouts/topbar') %>

  <main class="p-4 sm:p-6 max-w-3xl mx-auto w-full space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-slate-800">Daftarkan Siswa Baru di UKS</h2>
        <p class="text-xs text-slate-500">Input data siswa yang datang berobat ke UKS dan belum memiliki akun sistem</p>
      </div>
      <a href="/petugas/siswa" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs rounded-xl transition">
        &larr; Kembali
      </a>
    </div>

    <% if (error) { %>
      <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 text-rose-800 text-sm">
        <i data-lucide="alert-triangle" class="w-5 h-5 flex-shrink-0 text-rose-600"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
      <form action="/petugas/siswa/create" method="POST" class="space-y-6">
        <!-- Data Diri Siswa -->
        <div>
          <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2">
            <i data-lucide="user-plus" class="w-4 h-4 text-emerald-600"></i>
            Identitas Siswa
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Nama Lengkap Siswa *</label>
              <input type="text" name="nama" required placeholder="Contoh: Andi Pratama"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">NISN (Nomor Induk Siswa)</label>
              <input type="text" name="nisn" placeholder="Contoh: 0053334444"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Golongan Darah</label>
              <select name="golonganDarah" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
                <option value="">-- Tidak Tahu / Belum Cek --</option>
                <option value="A">A</option>
                <option value="B">B</option>
                <option value="AB">AB</option>
                <option value="O">O</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">No. HP / Telepon Ortu</label>
              <input type="text" name="teleponOrtu" placeholder="Contoh: 08123456789"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>
          </div>
        </div>

        <!-- Akun Kredensial (Opsional) -->
        <div class="border-t border-slate-100 pt-5">
          <h3 class="text-sm font-bold text-slate-800 mb-1 flex items-center gap-2">
            <i data-lucide="key" class="w-4 h-4 text-emerald-600"></i>
            Kredensial Login Siswa
          </h3>
          <p class="text-xs text-slate-500 mb-3">Dapat dikosongkan (otomatis dibuatkan username dari nama/NISN dan password: <code>password123</code>)</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Username Login</label>
              <input type="text" name="username" placeholder="Kosongkan untuk otomatis"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Password</label>
              <input type="password" name="password" placeholder="Default: password123"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>
          </div>
        </div>

        <!-- Riwayat Kesehatan Awal -->
        <div class="border-t border-slate-100 pt-5">
          <h3 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-2">
            <i data-lucide="shield-alert" class="w-4 h-4 text-emerald-600"></i>
            Peringatan Medis & Alergi
          </h3>

          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
                Alergi Obat <span class="text-rose-600 font-bold">(Wajib ditanyakan sebelum beri obat)</span>
              </label>
              <input type="text" name="alergiObat" placeholder="Misal: Penisilin, Paracetamol, atau 'Tidak Ada'"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Riwayat Penyakit Bawaan</label>
                <input type="text" name="riwayatPenyakit" placeholder="Asma, maag, vertigo, epilepsi, dll"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Alergi Makanan / Debu</label>
                <input type="text" name="alergiMakanan" placeholder="Udang, telur, susu, kacang, dll"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Kontak Darurat Orang Tua / Wali</label>
              <input type="text" name="kontakDarurat" placeholder="Nama wali & no telp"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
            </div>
          </div>
        </div>

        <!-- Opsi Langsung Catat Kunjungan -->
        <div class="p-4 bg-emerald-50/70 border border-emerald-200 rounded-2xl flex items-center gap-3">
          <input type="checkbox" name="catatKunjungan" id="catatKunjungan" value="1" checked
            class="w-4 h-4 text-emerald-600 rounded border-slate-300 focus:ring-emerald-500">
          <label for="catatKunjungan" class="text-xs font-medium text-emerald-900 cursor-pointer">
            <strong>Langsung daftarkan kunjungan UKS</strong> untuk siswa ini setelah data tersimpan (Pasien sedang di ruang UKS)
          </label>
        </div>

        <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100">
          <a href="/petugas/siswa" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 font-semibold text-xs rounded-xl transition">
            Batal
          </a>
          <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl shadow-md shadow-emerald-600/20 transition">
            Simpan & Daftarkan Siswa
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../../layouts/footer') %>
