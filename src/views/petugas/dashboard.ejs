<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../layouts/topbar') %>

  <main class="p-6 space-y-6">
    <!-- Header Quick Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-gradient-to-r from-emerald-600 to-teal-700 text-white p-6 rounded-3xl shadow-lg shadow-emerald-900/10">
      <div>
        <h2 class="text-xl font-bold tracking-tight">Selamat Datang, <%= user.nama %>!</h2>
        <p class="text-emerald-100 text-xs mt-1">Petugas Layanan Kesehatan Ruang UKS & Tim PMR</p>
      </div>

      <a href="/petugas/visits/create"
        class="inline-flex items-center gap-2 px-5 py-3 bg-white hover:bg-slate-50 text-emerald-700 font-bold text-xs rounded-2xl shadow transition">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span>Catat Kunjungan Pasien Baru</span>
      </a>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Siswa Berobat Hari Ini</p>
          <h3 class="text-2xl font-bold text-slate-800 mt-1"><%= stats.visitsToday %> Siswa</h3>
        </div>
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center">
          <i data-lucide="user-check" class="w-6 h-6"></i>
        </div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Sedang Dirawat di UKS</p>
          <h3 class="text-2xl font-bold text-amber-600 mt-1"><%= stats.activePatients %> Siswa</h3>
        </div>
        <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center">
          <i data-lucide="bed" class="w-6 h-6"></i>
        </div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Terdaftar Siswa</p>
          <h3 class="text-2xl font-bold text-blue-600 mt-1"><%= stats.totalStudents %> Siswa</h3>
        </div>
        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center">
          <i data-lucide="users" class="w-6 h-6"></i>
        </div>
      </div>
    </div>

    <!-- Live Active UKS Visits Table -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
      <div class="flex justify-between items-center mb-4">
        <div>
          <h3 class="text-base font-bold text-slate-800">Daftar Pasien Kunjungan UKS</h3>
          <p class="text-xs text-slate-500">Monitor kondisi & penanganan medis siswa terkini</p>
        </div>
        <a href="/petugas/visits" class="text-xs font-semibold text-emerald-600 hover:text-emerald-700">Lihat Semua Kunjungan &rarr;</a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
              <th class="py-3 px-3">Waktu & Tgl</th>
              <th class="py-3 px-3">Nama Siswa / Alergi</th>
              <th class="py-3 px-3">Keluhan & Vital</th>
              <th class="py-3 px-3">Tindakan & Obat</th>
              <th class="py-3 px-3 text-center">Status</th>
              <th class="py-3 px-3 text-center">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs">
            <% if (recentVisits.length === 0) { %>
              <tr>
                <td colspan="6" class="py-8 text-center text-slate-400">Belum ada kunjungan siswa dirawat hari ini.</td>
              </tr>
            <% } else { %>
              <% recentVisits.forEach(v => { %>
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="py-3.5 px-3 font-medium text-slate-700 whitespace-nowrap">
                    <%= new Date(v.tglKunjungan).toLocaleDateString('id-ID') %>
                    <span class="text-slate-400 text-[11px] block"><%= v.jamMasuk %> WIB</span>
                  </td>

                  <td class="py-3.5 px-3 font-semibold text-slate-800">
                    <%= v.student.nama %>
                    <span class="text-slate-400 text-[11px] block">GolDarah: <%= v.student.golonganDarah || '-' %></span>
                    <% if (v.student.healthProfile && v.student.healthProfile.alergiObat && v.student.healthProfile.alergiObat !== 'Tidak Ada' && v.student.healthProfile.alergiObat !== 'Belum diisi') { %>
                      <span class="inline-block mt-0.5 px-1.5 py-0.5 bg-rose-100 text-rose-700 text-[10px] font-bold rounded">
                        ⚠ Alergi: <%= v.student.healthProfile.alergiObat %>
                      </span>
                    <% } %>
                  </td>

                  <td class="py-3.5 px-3">
                    <p class="font-medium text-slate-800"><%= v.keluhan %></p>
                    <div class="flex items-center gap-2 mt-1 text-[11px] text-slate-500">
                      <% if (v.suhuTubuh) { %>
                        <span class="px-1.5 py-0.5 bg-slate-100 rounded font-semibold text-slate-700">Suhu: <%= v.suhuTubuh %>°C</span>
                      <% } %>
                      <% if (v.tensi) { %>
                        <span class="px-1.5 py-0.5 bg-slate-100 rounded font-semibold text-slate-700">Tensi: <%= v.tensi %></span>
                      <% } %>
                    </div>
                  </td>

                  <td class="py-3.5 px-3 text-slate-600">
                    <p><%= v.tindakan || '-' %></p>
                    <% if (v.prescriptions && v.prescriptions.length > 0) { %>
                      <div class="mt-1 space-y-0.5">
                        <% v.prescriptions.forEach(p => { %>
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200/60 rounded text-[10px] font-medium">
                            <i data-lucide="pill" class="w-3 h-3"></i> <%= p.medicine.namaObat %> (<%= p.jumlah %> <%= p.medicine.satuan %>)
                          </span>
                        <% }); %>
                      </div>
                    <% } %>
                  </td>

                  <td class="py-3.5 px-3 text-center whitespace-nowrap">
                    <% if (v.status === 'DIRAWAT') { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800">DIRAWAT</span>
                    <% } else if (v.status === 'KEMBALI_KELAS') { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">KEMBALI KELAS</span>
                    <% } else if (v.status === 'PULANG') { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-purple-100 text-purple-800">PULANG (IZIN)</span>
                    <% } else { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-100 text-rose-800">DIRUJUK FASKES</span>
                    <% } %>
                  </td>

                  <td class="py-3.5 px-3 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center gap-2">
                      <a href="/petugas/visits/<%= v.id %>/examine" title="Pemeriksaan Detail / Edit"
                        class="p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition">
                        <i data-lucide="stethoscope" class="w-4 h-4"></i>
                      </a>
                      <% if (v.status === 'PULANG' || v.status === 'DIRUJUK') { %>
                        <a href="/petugas/permit/<%= v.id %>/print" target="_blank" title="Cetak Surat Izin Digital"
                          class="p-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded-lg transition">
                          <i data-lucide="printer" class="w-4 h-4"></i>
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
