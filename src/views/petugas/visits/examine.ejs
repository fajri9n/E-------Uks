<%- include('../../layouts/header') %>
<%- include('../../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../../layouts/topbar') %>

  <main class="p-6 max-w-4xl mx-auto w-full space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-slate-800">Detail Pemeriksaan & Tindakan UKS</h2>
        <p class="text-xs text-slate-500">Rekam medis kunjungan siswa: <strong class="text-slate-800"><%= record.student.nama %></strong></p>
      </div>
      <div class="flex gap-2">
        <% if (record.status === 'PULANG' || record.status === 'DIRUJUK') { %>
          <a href="/petugas/permit/<%= record.id %>/print" target="_blank" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-xl transition flex items-center gap-1.5 shadow">
            <i data-lucide="printer" class="w-4 h-4"></i>
            <span>Cetak Surat Izin</span>
          </a>
        <% } %>
        <a href="/petugas/visits" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs rounded-xl transition">
          &larr; Kembali
        </a>
      </div>
    </div>

    <% if (success) { %>
      <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3 text-emerald-800 text-sm">
        <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 text-emerald-600"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 text-rose-800 text-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 text-rose-600"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Student Profile & Allergy Banner -->
    <div class="bg-gradient-to-r from-slate-900 to-slate-800 text-white p-6 rounded-2xl shadow-md space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-700 pb-3">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400">Identitas Pasien UKS</span>
          <h3 class="text-lg font-bold"><%= record.student.nama %></h3>
          <p class="text-xs text-slate-300">NISN: <%= record.student.nisn || '-' %> | Golongan Darah: <%= record.student.golonganDarah || '-' %></p>
        </div>
        <div class="text-right">
          <span class="text-[11px] text-slate-400">Petugas Pemeriksa:</span>
          <p class="text-xs font-semibold text-emerald-300"><%= record.petugas.nama %></p>
        </div>
      </div>

      <% const hp = record.student.healthProfile; %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs pt-1">
        <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700">
          <span class="text-slate-400 block text-[10px] uppercase font-semibold">Riwayat Penyakit:</span>
          <span class="font-medium text-slate-200"><%= hp ? (hp.riwayatPenyakit || 'Tidak ada') : 'Tidak ada' %></span>
        </div>

        <div class="bg-rose-950/40 p-2.5 rounded-xl border border-rose-900/60">
          <span class="text-rose-400 block text-[10px] uppercase font-bold">⚠ Alergi Obat:</span>
          <span class="font-bold text-rose-300"><%= hp ? (hp.alergiObat || 'Tidak ada') : 'Tidak ada' %></span>
        </div>

        <div class="bg-slate-800/80 p-2.5 rounded-xl border border-slate-700">
          <span class="text-slate-400 block text-[10px] uppercase font-semibold">Kontak Darurat Ortu:</span>
          <span class="font-medium text-slate-200"><%= hp ? (hp.kontakDarurat || record.student.teleponOrtu || 'Belum diisi') : 'Belum diisi' %></span>
        </div>
      </div>
    </div>

    <!-- Edit & Examination Form -->
    <form action="/petugas/visits/<%= record.id %>/examine" method="POST" class="space-y-6">
      
      <!-- Vital Signs & Symptoms -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
          <i data-lucide="activity" class="w-4 h-4 text-emerald-600"></i>
          Hasil Pemeriksaan Vital & Keluhan Pasien
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Tgl & Jam Masuk</label>
            <input type="text" disabled value="<%= new Date(record.tglKunjungan).toLocaleDateString('id-ID') %> - <%= record.jamMasuk %> WIB"
              class="w-full px-4 py-2.5 bg-slate-100 border border-slate-200 rounded-xl text-xs font-medium text-slate-600">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Suhu Tubuh (°C)</label>
            <input type="number" step="0.1" name="suhuTubuh" value="<%= record.suhuTubuh || '' %>" placeholder="36.5"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Tensi Darah (mmHg)</label>
            <input type="text" name="tensi" value="<%= record.tensi || '' %>" placeholder="120/80"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Keluhan Utama</label>
          <textarea name="keluhan" rows="2" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30"><%= record.keluhan %></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Tindakan Pertolongan Pertama (P3K)</label>
          <textarea name="tindakan" rows="2" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30"><%= record.tindakan || '' %></textarea>
        </div>
      </div>

      <!-- Prescribed Medicines List & Add New Prescription -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
          <i data-lucide="pill" class="w-4 h-4 text-emerald-600"></i>
          Obat Terpilih & Tambahan Resep
        </h3>

        <!-- Existing Prescriptions -->
        <div>
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">Resep Obat Yang Sudah Diberikan:</span>
          <% if (record.prescriptions.length === 0) { %>
            <p class="text-xs text-slate-400 italic">Belum ada obat yang diberikan pada pemeriksaan ini.</p>
          <% } else { %>
            <div class="space-y-2">
              <% record.prescriptions.forEach(p => { %>
                <div class="p-3 bg-emerald-50/70 border border-emerald-200/80 rounded-xl flex items-center justify-between text-xs">
                  <div>
                    <span class="font-bold text-emerald-900"><%= p.medicine.namaObat %></span>
                    <span class="text-emerald-700 ml-2">(<%= p.jumlah %> <%= p.medicine.satuan %>)</span>
                    <p class="text-[11px] text-emerald-600 mt-0.5"><%= p.dosis %></p>
                  </div>
                  <span class="text-[10px] font-semibold text-emerald-700 bg-white px-2 py-0.5 rounded border border-emerald-200">
                    Stok Sudah Terpotong
                  </span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <!-- Add Extra Medicine -->
        <div class="pt-3 border-t border-slate-100">
          <span class="text-xs font-semibold text-slate-700 uppercase tracking-wider block mb-2">+ Tambahkan Obat Baru (Stok Otomatis Terpotong)</span>
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end p-3 bg-slate-50 border border-slate-200/80 rounded-xl">
            <div class="sm:col-span-5">
              <label class="block text-[11px] font-semibold text-slate-600 uppercase mb-1">Pilih Obat</label>
              <select name="medicineId[]" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none">
                <option value="">-- Tanpa Obat Baru --</option>
                <% medicines.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.namaObat %> (Stok: <%= m.stok %> <%= m.satuan %>)</option>
                <% }); %>
              </select>
            </div>

            <div class="sm:col-span-2">
              <label class="block text-[11px] font-semibold text-slate-600 uppercase mb-1">Jumlah</label>
              <input type="number" name="jumlah[]" min="1" value="1"
                class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none">
            </div>

            <div class="sm:col-span-5">
              <label class="block text-[11px] font-semibold text-slate-600 uppercase mb-1">Dosis / Aturan Pakai</label>
              <input type="text" name="dosis[]" placeholder="Contoh: 1 tablet diminum di UKS"
                class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none">
            </div>
          </div>
        </div>
      </div>

      <!-- Decision & Leave Permit -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
          <i data-lucide="file-check" class="w-4 h-4 text-emerald-600"></i>
          Status Keputusan & Surat Izin Istirahat Digital
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Status Penanganan Siswa *</label>
            <select name="status" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
              <option value="DIRAWAT" <%= record.status === 'DIRAWAT' ? 'selected' : '' %>>DIRAWAT (Istirahat di Bed UKS)</option>
              <option value="KEMBALI_KELAS" <%= record.status === 'KEMBALI_KELAS' ? 'selected' : '' %>>KEMBALI_KELAS (Sudah Pulih)</option>
              <option value="PULANG" <%= record.status === 'PULANG' ? 'selected' : '' %>>PULANG (Izin Pulang ke Rumah)</option>
              <option value="DIRUJUK" <%= record.status === 'DIRUJUK' ? 'selected' : '' %>>DIRUJUK (Rujukan ke Puskesmas / RS)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Jam Keluar UKS</label>
            <input type="text" name="jamKeluar" value="<%= record.jamKeluar || '' %>" placeholder="Misal: 10:30 WIB"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Catatan Surat Izin Digital / Rujukan</label>
          <textarea name="catatanSurat" rows="3" placeholder="Instruksi / catatan resmi..."
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30"><%= record.catatanSurat || '' %></textarea>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <a href="/petugas/visits" class="px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition">
          Kembali
        </a>
        <button type="submit" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-lg transition flex items-center gap-2">
          <i data-lucide="save" class="w-4 h-4"></i>
          <span>Simpan Perubahan Pemeriksaan</span>
        </button>
      </div>

    </form>
  </main>
</div>

<%- include('../../layouts/footer') %>
