<%- include('../../layouts/header') %>
<%- include('../../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../../layouts/topbar') %>

  <main class="p-4 sm:p-6 max-w-4xl mx-auto w-full space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-slate-800">Registrasi & Catat Hasil Pemeriksaan UKS</h2>
        <p class="text-xs text-slate-500">Mencatat pendaftaran siswa sakit, hasil tanda vital, dan pemberian resep obat</p>
      </div>
      <a href="/petugas/visits" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs rounded-xl transition">
        &larr; Kembali
      </a>
    </div>

    <% if (error) { %>
      <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 text-rose-800 text-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 text-rose-600"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/petugas/visits/create" method="POST" class="space-y-6">
      
      <!-- Card 1: Data Pasien & Tanda Vital -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
          <i data-lucide="user" class="w-4 h-4 text-emerald-600"></i>
          1. Identitas Siswa & Tanda Vital (Pemeriksaan Fisik)
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider">Pilih Siswa / Pasien *</label>
              <a href="/petugas/siswa/create" class="text-[11px] font-semibold text-emerald-600 hover:text-emerald-700 hover:underline flex items-center gap-1">
                <i data-lucide="user-plus" class="w-3 h-3"></i>
                + Siswa Baru
              </a>
            </div>
            <select name="studentId" id="studentSelect" required onchange="showStudentProfile(this)"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
              <option value="">-- Pilih Siswa --</option>
              <% students.forEach(s => { %>
                <option value="<%= s.id %>"
                  <%= (typeof selectedStudentId !== 'undefined' && selectedStudentId === s.id) ? 'selected' : '' %>
                  data-nisn="<%= s.nisn || '-' %>"
                  data-goldarah="<%= s.golonganDarah || '-' %>"
                  data-penyakit="<%= s.healthProfile ? (s.healthProfile.riwayatPenyakit || 'Tidak ada') : 'Tidak ada' %>"
                  data-alergiobat="<%= s.healthProfile ? (s.healthProfile.alergiObat || 'Tidak ada') : 'Tidak ada' %>"
                  data-alergimakanan="<%= s.healthProfile ? (s.healthProfile.alergiMakanan || 'Tidak ada') : 'Tidak ada' %>">
                  <%= s.nama %> (NISN: <%= s.nisn || '-' %>)
                </option>
              <% }); %>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Jam Masuk UKS *</label>
            <input type="text" name="jamMasuk" required value="<%= new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
          </div>
        </div>

        <!-- Dynamic Health Profile Card Alert -->
        <div id="healthAlertCard" class="hidden p-4 rounded-xl bg-amber-50 border border-amber-200/80 text-xs text-amber-900 space-y-1">
          <p class="font-bold flex items-center gap-1.5 text-amber-800">
            <i data-lucide="shield-alert" class="w-4 h-4 text-amber-600"></i>
            Riwayat Rekam Medis Siswa:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1 text-[11px]">
            <div><span class="font-semibold">Riwayat Penyakit:</span> <span id="dispPenyakit">-</span></div>
            <div><span class="font-semibold text-rose-700">Alergi Obat:</span> <span id="dispAlergiObat" class="font-bold text-rose-700">-</span></div>
            <div><span class="font-semibold">Alergi Makanan:</span> <span id="dispAlergiMakanan">-</span></div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Suhu Tubuh (°C)</label>
            <input type="number" step="0.1" name="suhuTubuh" placeholder="36.5"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Tekanan Darah / Tensi (mmHg)</label>
            <input type="text" name="tensi" placeholder="120/80"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Keluhan Utama *</label>
          <textarea name="keluhan" rows="2" required placeholder="Jelaskan gejala/keluhan sakit siswa (misal: demam tinggi, pusing, mual, lecet)"
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Tindakan Pertolongan Pertama (P3K)</label>
          <textarea name="tindakan" rows="2" placeholder="Contoh: Kompres air hangat, pembersihan luka antiseptik, tirah baring"
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30"></textarea>
        </div>
      </div>

      <!-- Card 2: Pemberian Obat (Stok Otomatis Terpotong) -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
            <i data-lucide="pill" class="w-4 h-4 text-emerald-600"></i>
            2. Pemberian Obat / Alat P3K (Stok Terpotong Otomatis)
          </h3>
          <button type="button" onclick="addMedicineRow()"
            class="px-3 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-lg border border-emerald-200 transition flex items-center gap-1">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            Tambah Obat
          </button>
        </div>

        <div id="medicineRowsContainer" class="space-y-3">
          <div class="medicine-row grid grid-cols-1 sm:grid-cols-12 gap-3 items-end p-3 bg-slate-50 border border-slate-200/80 rounded-xl">
            <div class="sm:col-span-5">
              <label class="block text-[11px] font-semibold text-slate-600 uppercase mb-1">Pilih Obat / Alat P3K</label>
              <select name="medicineId[]" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none">
                <option value="">-- Tanpa Obat / Pilih Obat --</option>
                <% medicines.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.namaObat %> (Sisa Stok: <%= m.stok %> <%= m.satuan %>)</option>
                <% }); %>
              </select>
            </div>

            <div class="sm:col-span-2">
              <label class="block text-[11px] font-semibold text-slate-600 uppercase mb-1">Jumlah</label>
              <input type="number" name="jumlah[]" min="1" value="1"
                class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none">
            </div>

            <div class="sm:col-span-4">
              <label class="block text-[11px] font-semibold text-slate-600 uppercase mb-1">Dosis / Aturan Pakai</label>
              <input type="text" name="dosis[]" placeholder="Contoh: 1 tablet sesudah makan"
                class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs focus:outline-none">
            </div>

            <div class="sm:col-span-1 text-center">
              <button type="button" onclick="removeMedicineRow(this)"
                class="p-2 text-rose-500 hover:bg-rose-50 rounded-lg transition">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 3: Status Keputusan & Surat Izin -->
      <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
          <i data-lucide="file-text" class="w-4 h-4 text-emerald-600"></i>
          3. Keputusan Penanganan & Terbitkan Surat Izin
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Status Penanganan Siswa *</label>
            <select name="status" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
              <option value="DIRAWAT" class="text-amber-700 font-bold">DIRAWAT (Istirahat di Ruang UKS)</option>
              <option value="KEMBALI_KELAS" class="text-emerald-700 font-bold">KEMBALI_KELAS (Kondisi Membaik)</option>
              <option value="PULANG" class="text-purple-700 font-bold">PULANG (Izin Pulang ke Rumah)</option>
              <option value="DIRUJUK" class="text-rose-700 font-bold">DIRUJUK (Rujukan ke Puskesmas / RS)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Jam Keluar UKS</label>
            <input type="text" name="jamKeluar" placeholder="Misal: 10:30 WIB"
              class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Catatan Surat Izin Istirahat / Rujukan Pulang</label>
          <textarea name="catatanSurat" rows="2" placeholder="Catatan instruksi untuk orang tua / guru kelas / puskesmas rujukan..."
            class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30"></textarea>
        </div>
      </div>

      <!-- Submit buttons -->
      <div class="flex justify-end gap-3 pt-2">
        <a href="/petugas/visits" class="px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition">
          Batal
        </a>
        <button type="submit" class="px-6 py-3 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold text-xs rounded-xl shadow-lg shadow-emerald-600/20 transition flex items-center gap-2">
          <i data-lucide="check" class="w-4 h-4"></i>
          <span>Simpan Rekam Medis & Kurangi Stok</span>
        </button>
      </div>

    </form>
  </main>
</div>

<script>
  function showStudentProfile(selectElem) {
    const selectedOption = selectElem.options[selectElem.selectedIndex];
    const card = document.getElementById('healthAlertCard');
    if (!selectedOption.value) {
      card.classList.add('hidden');
      return;
    }
    card.classList.remove('hidden');
    document.getElementById('dispPenyakit').innerText = selectedOption.getAttribute('data-penyakit') || 'Tidak ada';
    document.getElementById('dispAlergiObat').innerText = selectedOption.getAttribute('data-alergiobat') || 'Tidak ada';
    document.getElementById('dispAlergiMakanan').innerText = selectedOption.getAttribute('data-alergimakanan') || 'Tidak ada';
  }

  function addMedicineRow() {
    const container = document.getElementById('medicineRowsContainer');
    const firstRow = container.querySelector('.medicine-row');
    const newRow = firstRow.cloneNode(true);
    // Reset values
    newRow.querySelector('select').value = '';
    newRow.querySelector('input[type="number"]').value = '1';
    newRow.querySelectorAll('input[type="text"]').forEach(i => i.value = '');
    container.appendChild(newRow);
    lucide.createIcons();
  }

  function removeMedicineRow(btn) {
    const rows = document.querySelectorAll('.medicine-row');
    if (rows.length > 1) {
      btn.closest('.medicine-row').remove();
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const studentSelect = document.getElementById('studentSelect');
    if (studentSelect && studentSelect.value) {
      showStudentProfile(studentSelect);
    }
  });
</script>

<%- include('../../layouts/footer') %>
