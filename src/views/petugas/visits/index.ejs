<%- include('../../layouts/header') %>
<%- include('../../layouts/sidebar') %>

<div class="flex-1 flex flex-col min-w-0 overflow-y-auto">
  <%- include('../../layouts/topbar') %>

  <main class="p-4 sm:p-6 space-y-4 sm:space-y-6">
    <!-- Header Actions -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-slate-800">Daftar Kunjungan & Rekam Medis UKS</h2>
        <p class="text-xs text-slate-500">Kelola catatan siswa berobat, pemeriksaan vital, pemberian obat, dan surat izin</p>
      </div>

      <a href="/petugas/visits/create"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-semibold text-xs rounded-xl shadow-md transition">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Catat Kunjungan Baru</span>
      </a>
    </div>

    <!-- Notices -->
    <% if (success) { %>
      <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center gap-3 text-emerald-800 text-sm">
        <i data-lucide="check-circle" class="w-5 h-5 flex-shrink-0 text-emerald-600"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 text-rose-800 text-sm">
        <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0 text-rose-600"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Search & Filter Bar -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm">
      <form action="/petugas/visits" method="GET" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
        <div class="relative sm:col-span-2">
          <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" name="search" value="<%= search %>" placeholder="Cari nama siswa / NISN..."
            class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
        </div>

        <select name="status" onchange="this.form.submit()"
          class="px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500/30">
          <option value="">Semua Status</option>
          <option value="DIRAWAT" <%= statusFilter === 'DIRAWAT' ? 'selected' : '' %>>DIRAWAT</option>
          <option value="KEMBALI_KELAS" <%= statusFilter === 'KEMBALI_KELAS' ? 'selected' : '' %>>KEMBALI KELAS</option>
          <option value="PULANG" <%= statusFilter === 'PULANG' ? 'selected' : '' %>>PULANG (IZIN)</option>
          <option value="DIRUJUK" <%= statusFilter === 'DIRUJUK' ? 'selected' : '' %>>DIRUJUK FASKES</option>
        </select>

        <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-xl transition">
          Cari Data
        </button>
      </form>
    </div>

    <!-- Visits Table -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[750px] text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200/80 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
              <th class="py-3.5 px-4">Tgl & Jam</th>
              <th class="py-3.5 px-4">Siswa</th>
              <th class="py-3.5 px-4">Keluhan & Vital</th>
              <th class="py-3.5 px-4">Penanganan & Obat</th>
              <th class="py-3.5 px-4 text-center">Status</th>
              <th class="py-3.5 px-4 text-center">Surat / Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs">
            <% if (visits.length === 0) { %>
              <tr>
                <td colspan="6" class="py-8 text-center text-slate-400">Tidak ada rekam medis kunjungan ditemukan.</td>
              </tr>
            <% } else { %>
              <% visits.forEach(v => { %>
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="py-3.5 px-4 font-medium text-slate-700 whitespace-nowrap">
                    <%= new Date(v.tglKunjungan).toLocaleDateString('id-ID') %>
                    <span class="text-slate-400 text-[11px] block"><%= v.jamMasuk %> WIB</span>
                  </td>

                  <td class="py-3.5 px-4 font-semibold text-slate-800">
                    <%= v.student.nama %>
                    <span class="text-slate-400 text-[11px] block">NISN: <%= v.student.nisn || '-' %></span>
                    <% if (v.student.healthProfile && v.student.healthProfile.alergiObat && v.student.healthProfile.alergiObat !== 'Tidak Ada' && v.student.healthProfile.alergiObat !== 'Belum diisi') { %>
                      <span class="inline-block mt-0.5 px-1.5 py-0.5 bg-rose-100 text-rose-700 text-[10px] font-bold rounded">
                        ⚠ Alergi Obat: <%= v.student.healthProfile.alergiObat %>
                      </span>
                    <% } %>
                  </td>

                  <td class="py-3.5 px-4">
                    <p class="font-medium text-slate-800"><%= v.keluhan %></p>
                    <div class="flex items-center gap-2 mt-1 text-[11px] text-slate-500">
                      <% if (v.suhuTubuh) { %>
                        <span class="px-1.5 py-0.5 bg-slate-100 rounded font-semibold text-slate-700">Suhu: <%= v.suhuTubuh %>°C</span>
                      <% } %>
                      <% if (v.tensi) { %>
                        <span class="px-1.5 py-0.5 bg-slate-100 rounded font-semibold text-slate-700">Tensi: <%= v.tensi %></span>
                      <% } %>
                    </div>
                  </td>

                  <td class="py-3.5 px-4 text-slate-600">
                    <p><%= v.tindakan || '-' %></p>
                    <% if (v.prescriptions && v.prescriptions.length > 0) { %>
                      <div class="mt-1 space-y-0.5">
                        <% v.prescriptions.forEach(p => { %>
                          <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200/60 rounded text-[10px] font-medium">
                            <i data-lucide="pill" class="w-3 h-3"></i> <%= p.medicine.namaObat %> (<%= p.jumlah %> <%= p.medicine.satuan %>)
                          </span>
                        <% }); %>
                      </div>
                    <% } %>
                  </td>

                  <td class="py-3.5 px-4 text-center whitespace-nowrap">
                    <% if (v.status === 'DIRAWAT') { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800">DIRAWAT</span>
                    <% } else if (v.status === 'KEMBALI_KELAS') { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">KEMBALI KELAS</span>
                    <% } else if (v.status === 'PULANG') { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-purple-100 text-purple-800">PULANG (IZIN)</span>
                    <% } else { %>
                      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-100 text-rose-800">DIRUJUK FASKES</span>
                    <% } %>
                  </td>

                  <td class="py-3.5 px-4 text-center whitespace-nowrap">
                    <div class="flex items-center justify-center gap-2">
                      <a href="/petugas/visits/<%= v.id %>/examine" title="Pemeriksaan Detail / Edit"
                        class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] rounded-lg transition inline-flex items-center gap-1">
                        <i data-lucide="stethoscope" class="w-3.5 h-3.5"></i>
                        <span>Pemeriksaan</span>
                      </a>
                      
                      <% if (v.status === 'PULANG' || v.status === 'DIRUJUK') { %>
                        <a href="/petugas/permit/<%= v.id %>/print" target="_blank" title="Cetak Surat Izin Digital"
                          class="px-3 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold text-[11px] border border-emerald-200 rounded-lg transition inline-flex items-center gap-1">
                          <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                          <span>Cetak Surat</span>
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../../layouts/footer') %>
